gem "rake"
gem "csv"
gem "base64"
gem "mutex_m"
gem "bigdecimal"

group :jekyll_plugins do
  gem "jekyll-paginate"
  gem "jekyll-sitemap"
  gem "jekyll-seo-tag"
  gem "jekyll-archives"
  gem "jekyll-include-cache"
  gem "jekyll-feed"
end

# Windows support
platforms :mingw, :x64_mingw, :mswin, :jruby do
